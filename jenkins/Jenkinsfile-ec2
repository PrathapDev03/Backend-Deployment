pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t smart-office-backend -f docker/Dockerfile .'
            }
        }
 
        stage('Remove Old Container') {
            steps {
                sh '''
                docker rm -f smart-office-container || true
                '''
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker run -d \
                --name smart-office-container \
                -p 5000:5000 \
                smart-office-backend
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                sleep 15
                curl http://localhost:5000
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful'
        }

        failure {
            echo 'Deployment Failed'
        }
    }
}