pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-southeast-1'
        ACCOUNT_ID = '379113716280'
        REPOSITORY = 'office-backend'
        CLUSTER = 'office-cluster'
        SERVICE = 'office-backend-service'
    }

    stages {

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t office-backend:v1 -f docker/Dockerfile .
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login --username AWS --password-stdin \
                $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                docker tag office-backend:v1 \
                $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$REPOSITORY:latest

                docker push \
                $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$REPOSITORY:latest
                '''
            }
        }

        stage('Deploy to ECS') {
            steps {
                sh '''
                aws ecs update-service \
                --cluster $CLUSTER \
                --service $SERVICE \
                --force-new-deployment \
                --region $AWS_REGION
                '''
            }
        }
    }
}